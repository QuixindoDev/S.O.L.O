# Field Shift - Variáveis de Ambiente

# Porta do servidor
PORT=8000

# Banco de dados: PostgreSQL/PostGIS ou SQLite local
# Para PostgreSQL: postgresql://usuario:senha@localhost:5432/field_shift
DATABASE_URL=sqlite:///./field_shift.db

# Ativar simulação mock para desenvolvimento offline / testes rápidos (true / false)
USE_MOCK_SATELLITE=false

# ID do Projeto Google Cloud / Earth Engine (opcional)
EE_PROJECT_ID=

# Caminho para credenciais de Service Account Google (opcional)
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/service_account.json

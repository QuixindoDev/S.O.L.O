/** Parâmetros de referência da NASA POWER (comunidade AG — agroclimatologia). */
import { et0Hargreaves } from "@/lib/agronomia";
export const NASA_POWER_PARAMETERS = [
  "T2M",
  "T2M_MAX",
  "T2M_MIN",
  "PRECTOTCORR",
  "RH2M",
  "ALLSKY_SFC_SW_DWN",
] as const;

export const NASA_POWER_BASE_URL =
  "https://power.larc.nasa.gov/api/temporal/daily/point";

export const NASA_POWER_CACHE_SECONDS = 86_400; // 24 h

export interface NasaPowerQuery {
  lat: number;
  lon: number;
  start: string; // YYYYMMDD
  end: string; // YYYYMMDD
}

export function buildNasaPowerUrl({ lat, lon, start, end }: NasaPowerQuery) {
  const params = new URLSearchParams({
    parameters: NASA_POWER_PARAMETERS.join(","),
    community: "AG",
    longitude: String(lon),
    latitude: String(lat),
    start,
    end,
    format: "JSON",
  });
  return `${NASA_POWER_BASE_URL}?${params.toString()}`;
}

/**
 * Consulta a NASA POWER com cache de 24 h na edge.
 * Poupa os dados móveis do utilizador — requisito do desafio.
 */
export async function fetchNasaPower(
  query: NasaPowerQuery,
  revalidate: number = NASA_POWER_CACHE_SECONDS
) {
  const res = await fetch(buildNasaPowerUrl(query), { next: { revalidate } });

  if (!res.ok) {
    throw new Error(`NASA POWER respondeu ${res.status}`);
  }

  return (await res.json()) as unknown;
}

export interface AgroDay {
  date: string; // YYYYMMDD
  label: string; // "15/11"
  dayOfWeek: string;
  tMean: number;
  tMax: number;
  tMin: number;
  rainMm: number;
  humidityPct: number | null;
  et0Mm: number;
}

export interface AgroSummary {
  days: AgroDay[]; // do mais antigo para o mais recente
  current: AgroDay | null; // último dia com dados
  lastSatellitePass: string | null; // YYYYMMDD
  rainTotalMm: number;
  et0TotalMm: number;
}

const MISSING = -999;
const WEEKDAYS = [
  "Domingo", "Segunda-feira", "Terça-feira", "Quarta-feira",
  "Quinta-feira", "Sexta-feira", "Sábado",
];

type PowerJson = {
  properties?: { parameter?: Record<string, Record<string, number>> };
};

const EMPTY_SUMMARY: AgroSummary = {
  days: [], current: null, lastSatellitePass: null, rainTotalMm: 0, et0TotalMm: 0,
};

const toYmd = (d: Date) => d.toISOString().slice(0, 10).replace(/-/g, "");
const num = (v?: number) => (v === undefined || v === MISSING ? null : v);

function parseYmd(s: string) {
  return new Date(Date.UTC(+s.slice(0, 4), +s.slice(4, 6) - 1, +s.slice(6, 8)));
}

function dayOfYear(d: Date) {
  const start = Date.UTC(d.getUTCFullYear(), 0, 0);
  return Math.floor((d.getTime() - start) / 86_400_000);
}

export async function getAgroSummary(
  lat: number,
  lon: number,
  days = 30
): Promise<AgroSummary> {
  const end = new Date();
  const start = new Date(end.getTime() - (days - 1) * 86_400_000);

  try {
    const raw = (await fetchNasaPower({
      lat, lon, start: toYmd(start), end: toYmd(end),
    })) as PowerJson;

    const p = raw.properties?.parameter;
    if (!p) return EMPTY_SUMMARY;

    const list: AgroDay[] = [];
    for (const date of Object.keys(p.T2M_MAX ?? {}).sort()) {
      const tMax = num(p.T2M_MAX?.[date]);
      const tMin = num(p.T2M_MIN?.[date]);
      const tMean = num(p.T2M?.[date]);
      const rain = num(p.PRECTOTCORR?.[date]);
      if (tMax === null || tMin === null || tMean === null || rain === null) continue;

      const d = parseYmd(date);
      list.push({
        date,
        label: `${date.slice(6, 8)}/${date.slice(4, 6)}`,
        dayOfWeek: WEEKDAYS[d.getUTCDay()],
        tMean, tMax, tMin,
        rainMm: rain,
        humidityPct: num(p.RH2M?.[date]),
        et0Mm: et0Hargreaves(tMean, tMax, tMin, lat, dayOfYear(d)),
      });
    }

    const current = list.at(-1) ?? null;
    return {
      days: list,
      current,
      lastSatellitePass: current?.date ?? null,
      rainTotalMm: Number(list.reduce((s, x) => s + x.rainMm, 0).toFixed(1)),
      et0TotalMm: Number(list.reduce((s, x) => s + x.et0Mm, 0).toFixed(1)),
    };
  } catch {
    return EMPTY_SUMMARY; // a página mostra "sem dados" em vez de rebentar
  }
}